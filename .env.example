# Скопируй в .env и заполни.

POSTGRES_DB=livedesk_db
POSTGRES_USER=livedesk
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

PRESENCE_GRPC_HOST=presence-service
PRESENCE_GRPC_PORT=9090

# Ключ подписи JWT, HS256 — не короче 32 символов: openssl rand -base64 48
JWT_SECRET=

# Оператор заводится миграцией V1: через API выдаётся только роль CLIENT.
# Хеш пароля — BCrypt:
#   docker run --rm httpd:2.4-alpine htpasswd -bnBC 10 "" 'пароль' | tr -d ':\n'
# Одинарные кавычки обязательны: без них `$` из хеша съест и shell, и docker compose.
OPERATOR_EMAIL=operator@livedesk.local
OPERATOR_PASSWORD_HASH=''
